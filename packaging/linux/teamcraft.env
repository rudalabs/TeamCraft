# TeamCraft system configuration (read by the service and by `teamcraft`
# commands run as the service user: `sudo -u teamcraft teamcraft user list`).
# Every setting is documented at
# https://rudalabs.github.io/TeamCraft/admin/configuration.html
# Values with spaces need quotes: TEAMCRAFT_INSTANCE_NAME="Our PLM".

# Listen on this computer only. To serve the network, set 0.0.0.0:8080 and
# TEAMCRAFT_PUBLIC_URL (create the first administrator before that, or with
# `sudo -u teamcraft teamcraft user create --username admin --role admin`).
TEAMCRAFT_BIND_ADDR=127.0.0.1:8080
#TEAMCRAFT_PUBLIC_URL=https://plm.example.org
#TEAMCRAFT_INSTANCE_NAME=TeamCraft

# PostgreSQL through its local socket: the service user "teamcraft" signs in
# as the database role of the same name (peer authentication), no password.
#   sudo -u postgres createuser teamcraft
#   sudo -u postgres createdb -O teamcraft teamcraft
TEAMCRAFT_DB_HOST=/run/postgresql
TEAMCRAFT_DB_NAME=teamcraft
TEAMCRAFT_DB_USER=teamcraft
# Another server: TEAMCRAFT_DATABASE_URL=postgres://user@host:5432/db
# (a password is best kept in a separate file: TEAMCRAFT_DB_PASSWORD_FILE=…)

# Uploaded files and cached 3D previews. `teamcraft backup DIR` writes this
# directory together with the database; see the operations guide.
TEAMCRAFT_VAULT_DIR=/var/lib/teamcraft/vault
#TEAMCRAFT_MAX_UPLOAD_MB=512

TEAMCRAFT_LOG_FORMAT=text
RUST_LOG=info,tower_http=info,sqlx=warn
