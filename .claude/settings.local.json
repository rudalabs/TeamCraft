{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Search",
      "WebSearch",
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Read(../**)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(tree *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(cargo *)",
      "Bash(rm -rf ./**)"
    ],
    "deny": [
      "Bash(cargo install *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/git-guard.sh\""
          }
        ]
      }
    ]
  }
}
