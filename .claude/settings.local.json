{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Search",
      "WebSearch",
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Read(../**)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(tree *)",
      "Bash(git branch)",
      "Bash(git pull)",
      "Bash(git add --all)",
      "Bash(git commit -m *)",
      "Bash(git push)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh *)",
      "Bash(rm -rf ./**)"
    ],
    "deny": [
      "Bash(* 2>&1)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/git-guard.sh\""
          }
        ]
      }
    ]
  }
}
