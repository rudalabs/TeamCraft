# TeamCraft server configuration for deploy/docker-compose.yml.
#
# install.sh copies this file to teamcraft.env (owner-only, mode 600) once and
# never overwrites it. Change a value, then apply it with
#   docker compose up -d
# Every setting: https://rudalabs.github.io/TeamCraft/admin/configuration.html
# Values with spaces need quotes: TEAMCRAFT_INSTANCE_NAME="Our PLM".
#
# Set by docker-compose.yml and therefore not here: the listen address inside
# the container, the database connection (service "db", password from
# secrets/db_password) and the vault directory (volume "vault").
# The published port is TEAMCRAFT_BIND in .env (default 127.0.0.1:8080).

# The address users open. Required as soon as TeamCraft is reached through
# another name than http://localhost:8080 – it is checked on every form
# (CSRF) and used for SSO redirects; https:// also turns on Secure cookies.
#TEAMCRAFT_PUBLIC_URL=https://plm.example.org
#TEAMCRAFT_INSTANCE_NAME=TeamCraft

# Logs: `docker compose logs teamcraft`.
TEAMCRAFT_LOG_FORMAT=text
RUST_LOG=info,tower_http=info,sqlx=warn

#TEAMCRAFT_MAX_UPLOAD_MB=512
#TEAMCRAFT_SESSION_TTL_HOURS=72

# First administrator. install.sh offers to create it on the command line
# (`docker compose exec teamcraft teamcraft user create --username admin --role admin`).
# Alternatively set a start password here; it is used only while the
# database has no accounts – change it after the first login.
#TEAMCRAFT_BOOTSTRAP_ADMIN_USERNAME=admin
#TEAMCRAFT_BOOTSTRAP_ADMIN_PASSWORD=

# Single sign-on with any OpenID Connect provider (docs: admin/users.html).
#TEAMCRAFT_OIDC_ISSUER_URL=https://auth.example.org/application/o/teamcraft/
#TEAMCRAFT_OIDC_CLIENT_ID=teamcraft
#TEAMCRAFT_OIDC_CLIENT_SECRET=
#TEAMCRAFT_OIDC_ADMIN_GROUP=teamcraft-admins
#TEAMCRAFT_OIDC_EDITOR_GROUP=teamcraft-editors
#TEAMCRAFT_LOCAL_LOGIN=false

# E-mail notifications.
#TEAMCRAFT_SMTP_URL=smtp://mail.example.org:587?tls=required
#TEAMCRAFT_MAIL_FROM="TeamCraft <teamcraft@example.org>"

# Mattermost notifications and error reports (incoming webhooks).
#TEAMCRAFT_MATTERMOST_WEBHOOK=
#TEAMCRAFT_MATTERMOST_DIRECT=false
#MATTERMOST_ERROR_WEBHOOK=
