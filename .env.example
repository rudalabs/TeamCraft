# TeamCraft configuration template – the only tracked copy of the configuration.
#
# All real configuration and secrets live in secrets/ (git-ignored as a whole):
#
#   mkdir -p secrets
#   cp .env.example secrets/.env                          # then edit secrets/.env
#   printf '%s' 'teamcraft-dev-password' > secrets/db_password
#
# `cargo run`, `cargo test` and the dev `app` container read secrets/.env;
# secrets/db_password is shared by the dev PostgreSQL container and TeamCraft.
# Quote values that contain spaces: NAME="WARR SSO".
# Every variable can also be given as a file by appending _FILE (relative paths
# are resolved from the repository root), which is how secrets are passed in
# production (see DEPLOYMENT.md §3).

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# Address to listen on. Use 0.0.0.0:8080 inside containers.
TEAMCRAFT_BIND_ADDR=127.0.0.1:8080
# Externally visible URL (no trailing slash). Used for SSO redirects, the
# CSRF origin check and the Secure cookie flag (https:// → Secure cookies).
TEAMCRAFT_PUBLIC_URL=http://localhost:8080
# Name shown in the header and page titles.
TEAMCRAFT_INSTANCE_NAME=TeamCraft

# ---------------------------------------------------------------------------
# Database (PostgreSQL 14+)
# ---------------------------------------------------------------------------
# Either one URL …
# TEAMCRAFT_DATABASE_URL=postgres://teamcraft:<password>@localhost:5432/teamcraft
# … or the individual parts (preferred: no URL-encoding of special characters):
TEAMCRAFT_DB_HOST=localhost
TEAMCRAFT_DB_PORT=5432
TEAMCRAFT_DB_NAME=teamcraft
TEAMCRAFT_DB_USER=teamcraft
# SECRET – read from the file that the dev PostgreSQL container uses as well
# (alternatively inline: TEAMCRAFT_DB_PASSWORD=…)
TEAMCRAFT_DB_PASSWORD_FILE=secrets/db_password
# disable | prefer | require | verify-ca | verify-full
TEAMCRAFT_DB_SSLMODE=prefer
TEAMCRAFT_DB_MAX_CONNECTIONS=10

# ---------------------------------------------------------------------------
# File vault
# ---------------------------------------------------------------------------
# Directory for uploaded files (content addressed). Back it up!
TEAMCRAFT_VAULT_DIR=./data/vault
TEAMCRAFT_MAX_UPLOAD_MB=512

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Session lifetime in hours.
TEAMCRAFT_SESSION_TTL_HOURS=72
# Force the Secure cookie flag (default: true when TEAMCRAFT_PUBLIC_URL is https).
# TEAMCRAFT_COOKIE_SECURE=false

# Local username/password accounts. Default: true without OIDC, false with OIDC.
TEAMCRAFT_LOCAL_LOGIN=true
# Initial administrator, created on startup when the database has no users.
TEAMCRAFT_BOOTSTRAP_ADMIN_USERNAME=admin
# SECRET – at least 10 characters. Remove after the first start.
TEAMCRAFT_BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# Single sign-on via OpenID Connect (Authentik). Leave the issuer empty to disable.
# Redirect URI to register at the provider: ${TEAMCRAFT_PUBLIC_URL}/auth/oidc/callback
TEAMCRAFT_OIDC_ISSUER_URL=
TEAMCRAFT_OIDC_CLIENT_ID=
# SECRET
TEAMCRAFT_OIDC_CLIENT_SECRET=
TEAMCRAFT_OIDC_DISPLAY_NAME="WARR SSO"
TEAMCRAFT_OIDC_SCOPES="openid profile email"
TEAMCRAFT_OIDC_GROUPS_CLAIM=groups
TEAMCRAFT_OIDC_USERNAME_CLAIM=preferred_username
# Group → role mapping. Members of neither group get the viewer role,
# unless TEAMCRAFT_OIDC_VIEWER_GROUP is set (then that group is required).
# What CAD editors may change is limited to their project groups; each project
# group can be bound to an IdP group (e.g. teamcraft-nixus) on its page.
TEAMCRAFT_OIDC_ADMIN_GROUP=teamcraft-admins
TEAMCRAFT_OIDC_EDITOR_GROUP=teamcraft-editors
# TEAMCRAFT_OIDC_VIEWER_GROUP=teamcraft-users

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# SECRET – Mattermost incoming webhook that receives internal server errors.
MATTERMOST_ERROR_WEBHOOK=
# Log format: text | json
TEAMCRAFT_LOG_FORMAT=text
# Log filter (tracing EnvFilter syntax)
RUST_LOG=info,tower_http=info,sqlx=warn

# ---------------------------------------------------------------------------
# Tests (cargo test)
# ---------------------------------------------------------------------------
# The integration tests use the database configured above (the role needs
# CREATEDB; every test creates and drops its own teamcraft_test_* database).
# Optional override, e.g. for CI:
# TEAMCRAFT_TEST_DATABASE_URL=postgres://teamcraft:<password>@localhost:5432/teamcraft
